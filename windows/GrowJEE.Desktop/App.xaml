<Application x:Class="GrowJEE.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#080A10"/><SolidColorBrush x:Key="Panel" Color="#B51A2030"/><SolidColorBrush x:Key="TextMain" Color="#F4F6FF"/><SolidColorBrush x:Key="TextMuted" Color="#A8B1C7"/><SolidColorBrush x:Key="Cyan" Color="#75F4E8"/><SolidColorBrush x:Key="Blue" Color="#A7AFFF"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#38263349"/><Setter Property="BorderBrush" Value="#50FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#60465B75"/><Setter TargetName="surface" Property="BorderBrush" Value="#9575F4E8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value=".72"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#B6111521"/><Setter Property="BorderBrush" Value="#48FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="Margin" Value="0,4,0,9"/><Setter Property="CaretBrush" Value="{StaticResource Cyan}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#D40E121D"/><Setter Property="BorderBrush" Value="#48FFFFFF"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,9"/></Style>
  </Application.Resources>
</Application>
