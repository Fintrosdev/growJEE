<Application x:Class="GrowJEE.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#080A10"/><SolidColorBrush x:Key="Panel" Color="#141824"/><SolidColorBrush x:Key="TextMain" Color="#EEF2FB"/><SolidColorBrush x:Key="TextMuted" Color="#9BA5B9"/><SolidColorBrush x:Key="Cyan" Color="#6CE7E2"/><SolidColorBrush x:Key="Blue" Color="#98A4FF"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#1B2030"/><Setter Property="BorderBrush" Value="#343D50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#0E1119"/><Setter Property="BorderBrush" Value="#30394A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,3,0,8"/><Setter Property="CaretBrush" Value="{StaticResource Cyan}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="#0E1119"/><Setter Property="BorderBrush" Value="#30394A"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3,0,8"/></Style>
  </Application.Resources>
</Application>
