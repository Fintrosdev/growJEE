<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GrowJEE</AssemblyName>
    <RootNamespace>GrowJEE.Desktop</RootNamespace>
    <ApplicationIcon>Assets\growjee-emblem.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Content Include="chapters.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\growjee-emblem.png" />
    <Resource Include="Assets\growjee-emblem.ico" />
  </ItemGroup>
</Project>
