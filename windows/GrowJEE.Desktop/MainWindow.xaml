<Window x:Class="GrowJEE.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GrowJEE · Project M" Width="1420" Height="900" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource Ink}" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI" Loaded="Window_Loaded">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0D1018" BorderBrush="#202637" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,4,0,22"><Border Width="42" Height="42" CornerRadius="13" Background="#172433" BorderBrush="#6CE7E2" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="M" Foreground="#6CE7E2" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JEE Control Centre" FontWeight="Bold" FontSize="16" Margin="0,12,0,2"/><TextBlock Text="PROJECT M  ·  STUDY OS" Foreground="#6CE7E2" FontSize="9" FontWeight="Bold"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><TextBlock x:Name="CloudStatus" Text="LOCAL MODE" Foreground="#9BA5B9" FontSize="10" Margin="4,0,0,7"/><Button Content="☁  Account &amp; sync" Click="Account_Click" Background="#22213A" BorderBrush="#7D78C6"/><Button Content="Export backup" Click="Export_Click"/><Button Content="Import backup" Click="Import_Click"/></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="26,18,26,20">
      <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0"><TextBlock x:Name="PageSubtitle" Text="YOUR PREPARATION OVERVIEW" Foreground="#9BA5B9" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="PROJECT M   /   GROWJEE" Foreground="#6CE7E2" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent"/></ScrollViewer>
    </Grid>
  </Grid>
</Window>
