<Window x:Class="GrowJEE.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GrowJEE · Project M" Width="1420" Height="900" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{StaticResource Ink}" Foreground="{StaticResource TextMain}" FontFamily="Segoe UI Variable Display, Segoe UI" Loaded="Window_Loaded">
  <Window.Resources><DropShadowEffect x:Key="GlassGlow" Color="#5B77FF" BlurRadius="34" ShadowDepth="0" Opacity=".16"/><LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#111827"/><GradientStop Offset=".48" Color="#0A0D16"/><GradientStop Offset="1" Color="#101326"/></LinearGradientBrush></Window.Resources>
  <Grid Background="{StaticResource Backdrop}">
    <Canvas IsHitTestVisible="False" ClipToBounds="True"><Ellipse Width="500" Height="500" Canvas.Left="210" Canvas.Top="-270" Fill="#246CE7E2" Effect="{StaticResource GlassGlow}"/><Ellipse Width="500" Height="500" Canvas.Right="-240" Canvas.Bottom="-250" Fill="#2698A4FF" Effect="{StaticResource GlassGlow}"/></Canvas>
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#80131926" BorderBrush="#42FFFFFF" BorderThickness="1" CornerRadius="25" Padding="17" Effect="{StaticResource GlassGlow}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="2,5,2,24"><Border Width="46" Height="46" CornerRadius="16" HorizontalAlignment="Left" BorderBrush="#B875F4E8" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#886CE7E2"/><GradientStop Offset="1" Color="#886A72D8"/></LinearGradientBrush></Border.Background><TextBlock Text="M" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="GrowJEE" FontWeight="Bold" FontSize="19" Margin="0,13,0,2"/><TextBlock Text="YOUR STUDY UNIVERSE" Foreground="#75F4E8" FontSize="9" FontWeight="Bold"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Border Background="#34131926" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="13" Padding="10" Margin="0,0,0,9"><TextBlock x:Name="CloudStatus" Text="LOCAL MODE" Foreground="#A8B1C7" FontSize="10" TextTrimming="CharacterEllipsis"/></Border><Button Content="☁  Account &amp; sync" Click="Account_Click" Background="#45494379" BorderBrush="#887D78D1"/><Button Content="Export backup" Click="Export_Click"/><Button Content="Import backup" Click="Import_Click"/></StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18,0,0,0"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#49151B29" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="20" Padding="18,10" Margin="0,0,0,12"><DockPanel><StackPanel><TextBlock Text="STUDY COMMAND" Foreground="#A8B1C7" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="YOUR PREPARATION OVERVIEW" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><TextBlock Text="PROJECT M   /   GROWJEE" Foreground="#75F4E8" FontWeight="Bold" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
        <Border Grid.Row="1" Background="#33131926" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="24" Padding="21,17"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent"/></ScrollViewer></Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
