<Window x:Class="GrowJEE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GrowJEE · Project M" Width="1420" Height="900" MinWidth="1060" MinHeight="700"
        Icon="pack://application:,,,/Assets/growjee-emblem.ico"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource Ink}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI Variable Display, Segoe UI" Loaded="Window_Loaded">

  <!-- Slow drifting light orbs behind the glass -->
  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Orb1T" Storyboard.TargetProperty="X" From="-60" To="120" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Orb1T" Storyboard.TargetProperty="Y" From="0" To="90" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Orb2T" Storyboard.TargetProperty="X" From="80" To="-140" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Orb2T" Storyboard.TargetProperty="Y" From="40" To="-110" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Orb3T" Storyboard.TargetProperty="X" From="-30" To="90" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Orb3T" Storyboard.TargetProperty="Y" From="-50" To="60" Duration="0:0:16" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Grid Background="{StaticResource Backdrop}">

    <Grid IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="680" Height="680" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,-320,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#586CE7E2" Offset="0"/>
            <GradientStop Color="#006CE7E2" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="Orb1T"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-300">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#559A8CFF" Offset="0"/>
            <GradientStop Color="#009A8CFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="Orb2T"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-140,0,0,-170">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#40FF7EC8" Offset="0"/>
            <GradientStop Color="#00FF7EC8" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="Orb3T"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>

    <Grid Margin="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Style="{StaticResource Card}" CornerRadius="26" Padding="16,18" Margin="0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="4,4,4,26">
            <Border Width="48" Height="48" CornerRadius="16" HorizontalAlignment="Left" BorderBrush="#B875F4E8" BorderThickness="1" Effect="{StaticResource CyanGlow}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#AA6CE7E2" Offset="0"/>
                  <GradientStop Color="#AA6A72D8" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Image Source="Assets/growjee-emblem.png" Stretch="UniformToFill" ClipToBounds="True"/>
            </Border>
            <TextBlock Text="GrowJEE" FontWeight="Bold" FontSize="21" Margin="0,14,0,2"/>
            <TextBlock Text="YOUR STUDY UNIVERSE" Foreground="{StaticResource Cyan}" FontSize="9" FontWeight="Bold"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Border Background="#26000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="13" Padding="12,9" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="CloudDot" Width="8" Height="8" Fill="{StaticResource TextDim}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CloudStatus" Text="Local mode" Foreground="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
              </StackPanel>
            </Border>
            <Button Content="☁   Account &amp; sync" Click="Account_Click" Margin="0,3" HorizontalContentAlignment="Left" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Export backup" Click="Export_Click" Margin="0,3"/>
            <Button Content="Import backup" Click="Import_Click" Margin="0,3"/>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Navigation"/>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Main column -->
      <Grid Grid.Column="1" Margin="18,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="74"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,0" Margin="0,0,0,14" CornerRadius="22">
          <DockPanel VerticalAlignment="Center">
            <Border DockPanel.Dock="Right" Background="#22000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,7" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="PROJECT M" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="10"/>
                <TextBlock Text="  /  " Foreground="{StaticResource TextDim}" FontSize="10"/>
                <TextBlock x:Name="DateText" Text="" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="10"/>
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="STUDY COMMAND" Foreground="{StaticResource TextDim}" FontSize="9" FontWeight="Bold"/>
              <TextBlock x:Name="PageSubtitle" Text="Your preparation overview" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0" CornerRadius="26">
          <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PageContent" Margin="28,22,26,24"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Toast -->
    <Border x:Name="ToastHost" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,34" Padding="18,12" CornerRadius="16" Background="#F0161C2B" BorderBrush="#5575F4E8" BorderThickness="1"
            Effect="{StaticResource SoftShadow}">
      <Border.RenderTransform><TranslateTransform x:Name="ToastT"/></Border.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="✓" Foreground="{StaticResource Cyan}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
